<apex:page standardController="CMPL123CME__EU_MIR__c">
  <apex:outputPanel rendered="{!OR(CONTAINS(CMPL123CME__EU_MIR__c.CMPL123_WF_Status__c,'Closed-Done'), CONTAINS(CMPL123CME__EU_MIR__c.CMPL123_WF_Status__c,'Closed - Waived'), CONTAINS(CMPL123CME__EU_MIR__c.CMPL123_WF_Status__c,'Closed-Voided'), CONTAINS(CMPL123CME__EU_MIR__c.CMPL123_WF_Status__c,'Closed-Void'))}">
        <div>
            <apex:pageMessage escape="false" summary="{!$Label.MIR_Check_Validate_Form_for_Closed_Status}" severity="error" strength="3" />
        </div>
        <div align="center" style="margin: 10px;">
            <apex:outputLink value="/{!CMPL123CME__EU_MIR__c.Id}" id="viewQuest" onmousemove="this.style.background='#8AB529';this.style.color='white'" onmouseout="this.style.background='#1797c0';this.style.color='white'" style="background:#1797c0;color: white;padding:0.5%;border-radius:6px;text-decoration: none;">Close</apex:outputLink>
        </div>
    </apex:outputPanel>
    <!--Defect#182 Fix Varsha Hariharan-->
    <apex:outputPanel rendered="{!AND(NOT(CONTAINS(CMPL123CME__EU_MIR__c.CMPL123_WF_Status__c,'Closed-Done')), NOT(CONTAINS(CMPL123CME__EU_MIR__c.CMPL123_WF_Status__c,'Closed - Waived')), NOT(CONTAINS(CMPL123CME__EU_MIR__c.CMPL123_WF_Status__c,'Closed-Voided')), NOT(CONTAINS(CMPL123CME__EU_MIR__c.CMPL123_WF_Status__c,'Closed-Void')))}">
            <script type="application/javascript">
            window.onload = function loadFunction(){
                window.location = '/apex/CMPL123CME__EUMIRValidation?Id={!CMPL123CME__EU_MIR__c.Id}';
            }
            </script>
    </apex:outputPanel>
</apex:page>