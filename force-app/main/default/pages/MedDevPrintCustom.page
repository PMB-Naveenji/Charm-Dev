                    <apex:image height="15px" width="15px" url="{!URLFOR($Resource.CMPL123CME__MDR, if(CMPL123CME__MEDDEV__c.CMPL123CME__Serious_Public_Threat__c == 'No','/checkbox_yes.png','/checkbox_no.png'))}"/> <span style="font-size: 12px; font-weight: 100;vertical-align: top;"> No</span> <br/>
