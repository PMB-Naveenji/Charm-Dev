    <link href="{!URLFOR($Resource.JqueryUIDatatable,'/JqueryUIDatatable/css/jquery.dataTables.min.css')}" rel="stylesheet" type="text/css" />
    <link href="{!URLFOR($Resource.JqueryUIDatatable,'/JqueryUIDatatable/css/jquery-ui.css')}" rel="stylesheet" type="text/css" />
    <link href="{!URLFOR($Resource.JqueryUIDatatable,'/JqueryUIDatatable/css/fixedColumns.dataTables.min.css')}" rel="stylesheet" type="text/css" />
    
    <apex:includeScript value="{!URLFOR($Resource.JqueryUIDatatable,'/JqueryUIDatatable/js/jquery.dataTables.min.js')}"/>
    <apex:includeScript value="{!URLFOR($Resource.JqueryUIDatatable,'/JqueryUIDatatable/js/jquery-ui.js')}"/>
    <apex:includeScript value="{!URLFOR($Resource.JqueryUIDatatable,'/JqueryUIDatatable/js/dataTables.fixedColumns.min.js')}"/>
    
    <link href="//cdn.datatables.net/1.10.13/css/jquery.dataTables.min.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/smoothness/jquery-ui.css"/>
    <link rel="stylesheet" href="//cdn.datatables.net/fixedcolumns/3.2.6/css/fixedColumns.dataTables.min.css"/>
    
    <style>
        .changeTracker{
